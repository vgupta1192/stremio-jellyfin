From c38f2d732182c383dc5ec24eeea3b5ef25beaf16 Mon Sep 17 00:00:00 2001
From: vgupta1192 <vgupta1192@users.noreply.github.com>
Date: Sat, 3 Oct 2026 18:52:42 +0530
Subject: [PATCH] patch: plain Jellyfin addon display name

---
 manifest.js | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/manifest.js b/manifest.js
index 188656a..cffa8ea 100644
--- a/manifest.js
+++ b/manifest.js
@@ -86,7 +86,9 @@ export function createManifest(config) {
             "movie",
             "series"
         ],
-        "name": slug ? `Jellyfin (${catalogs.map(c => c.name).join(", ") || "no catalogs"})` : "Jellyfin",
+        // Display name is always plain "Jellyfin" - the suffix listing catalogs made the
+        // name unwieldy in the apps' stream headers and addon lists (user request 2026-10-03).
+        "name": "Jellyfin",
         "description": "Stremio Jellyfin integration",
         "behaviorHints": {
             "configurable": true
